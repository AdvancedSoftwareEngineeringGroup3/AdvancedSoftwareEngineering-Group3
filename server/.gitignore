# Server Code .gitignore

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
.coverage
.coverage.*
.cache
pytest_cache/
nosetests.xml
coverage.xml
*.cover
*.py,cover
htmlcov/

# Virtual environment folders
venv/
.venv/
ENV/
env/
.envrc

# IDE / editor settings
.vscode/
.idea/
*.swp

# macOS / Windows
.DS_Store
Thumbs.db

# Environment variables
.env
.env.*

# Logs
*.log
logs/

# Docker-related (optional)
docker-compose.override.yml