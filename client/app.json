{
  "expo": {
    "name": "Roots",
    "slug": "client",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/SustainablityDashboard/Rootyfullbloom.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./src/assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "INTERNET",
        "WRITE_EXTERNAL_STORAGE",
        "READ_EXTERNAL_STORAGE",
        "FOREGROUND_SERVICE",
        "VIBRATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/SustainablityDashboard/Rootyfullbloom.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.rootscs7cs3.client"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "EXPO_PUBLIC_API_URL": "http://134.199.188.243"
    },
    "plugins": [
      "expo-location",
      "expo-file-system"
    ]
  }
}
